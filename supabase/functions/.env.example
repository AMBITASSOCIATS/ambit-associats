# Variables de les Edge Functions (aprovar-solicitud i portal-*).
# En local: copia aquest fitxer a supabase/functions/.env (no es puja al repo).
# En producció: supabase secrets set NOM=valor
ALLOWED_ORIGINS=https://www.ambit.ad,http://localhost:3000,http://127.0.0.1:3000

# Portal de signatura
# Clau AES-256-GCM de 32 bytes en base64 (openssl rand -base64 32).
# Ha de ser la mateixa en local i a producció; guardeu-la al gestor de contrasenyes.
PORTAL_IBAN_KEY=
# Identificador del formulari de Formspree per a l'avís "Nova autorització signada
# al portal" (sense cap dada del client). En local es deixa buit perquè les proves
# no enviïn avisos reals; la prova supabase/tests/edge/avis-formspree.test.mjs
# l'activa contra un receptor local amb FORMSPREE_BASE_URL.
FORMSPREE_FORM_ID=
# Opcional: base dels enllaços (per defecte https://www.ambit.ad)
# PORTAL_BASE_URL=https://www.ambit.ad
